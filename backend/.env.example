# WAQI API Token (Sign up for free at https://aqicn.org/data-platform/token/)
WAQI_TOKEN=demo

# AWS Credentials (Required for Live Amazon Bedrock & SNS Dispatch)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Amazon Bedrock Model ID (Nova Lite activates instantly, no approval needed;
# switch to anthropic.claude-3-5-sonnet-20241022-v2:0 once/if Claude access is granted)
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Amazon SNS Alert Topic ARN
SNS_TOPIC_ARN=

# DynamoDB Table Name
TABLE_NAME=vayuguard-telemetry
